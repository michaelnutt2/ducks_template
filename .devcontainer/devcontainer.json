{
  "name": "COSC 1301 PostgreSQL + pgAdmin",
  "dockerComposeFile": "docker-compose.yml",
  "service": "pgadmin",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8080, 5432],
  "portsAttributes": {
    "8080": {
      "label": "pgAdmin",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "echo 'pgAdmin available at port 8080 - login: student@cosc1301.local / password'"
}
